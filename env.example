# Gateway Connect — environment variables
# Every key here is registered in config.ts (ENV_KEYS). Do not read
# process.env / import.meta.env directly; import CONFIG from ./config instead.

# --- Supabase (client + serverless) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Live WebSocket gateway ---
VITE_LIVE_WS_URL=

# --- Application host ---
APP_URL=
VITE_APP_URL=

# --- Paynow Zimbabwe ---
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_MERCHANT_EMAIL=
PAYNOW_RETURN_URL=
PAYNOW_RESULT_URL=

# --- Runtime / build tooling ---
PORT=
LIVE_PORT=
DISABLE_HMR=
